# ---- Big data files (kept locally, not versioned) ----
*.parquet
*.bak
*.bak[0-9]
*.pkl
*.pkl.gz
*.tar.gz
*.tar
*.gz
*.npy
*.npz
*.pt
*.ckpt

# Large data / results directories
# Anchored to the repo root ON PURPOSE. Unanchored, `embeddings/` also matches
# scripts/embeddings/, which silently ignored new code added there -- the two
# files already tracked in it predate the rule.
/embeddings/
generated_cifs/
relaxed/
predictions/
validation/
steering_vectors/

# --- ChemSteer
ChemSteer/

# ---- Virtual environments ----
*_venv/
venv/
.venv/

# ---- Runtime logs & scratch ----
logs/
trash/

# ---- Python / OS caches ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store

# vim swap files
*.swp
*.swo
*~

# api keys
api_keys.json

# ---- model weights ----
# llamat-2-cif is ~27 GB of safetensors. Downloaded with
#   hf download m3rg-iitd/llamat-2-cif --local-dir models/llamat2_cif
models/
*.safetensors
*.pt

# ---- untracked reference clones ----
# Both are full git checkouts of other projects kept here for reference (llamat 726 MB,
# CrystaLLM-pi 91 MB). They are NOT submodules; committing them would nest a repo inside
# this one. The parts of llamat we actually depend on are vendored into
# scripts/llamat_prompts.py precisely so this directory can stay untracked.
llamat/
CrystaLLM-pi/

# Results data: generations, flags, relaxed CIFs and predictions. Large, regenerable
# from the configs in experiments_configs/ plus the run record in runs.tsv, and never
# reviewed as a diff. The DERIVED tables and figures are tracked under analysis/ instead;
# the two text files that used to live here were moved there and to docs/.
/steering_results/
